APP_ENV=development
APP_ADMIN_USERNAME=yes2310
APP_ADMIN_PASSWORD=replace-with-a-strong-password
APP_COOKIE_SECURE=0
DEBUG_ERRORS=1
MAX_UPLOAD_BYTES=2147483648

APP_HOST=0.0.0.0
APP_PORT=9002

CHATMOCK_HOST=127.0.0.1
CHATMOCK_PORT=8000
AUTO_START_CHATMOCK=1

LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=anything
LLM_MODEL=gpt-5.4
LLM_TIMEOUT=480

WHISPER_MODEL=large-v3
WHISPER_COMPUTE=float16
WHISPER_GPU_IDS=auto

VAULT_PATH=./vault
UPLOAD_DIR=./uploads
OUTPUT_ROOT=./output
JOBS_DB_PATH=./jobs.db
